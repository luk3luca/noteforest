{
  "name": "@noteforest/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "NoteForest desktop shell and branch editor",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.github.luk3luca.noteforest",
    "productName": "NoteForest",
    "copyright": "Copyright \u00a9 2026 Luca Martinelli",
    "directories": {
      "buildResources": "resources",
      "output": "../../dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/pdfjs-dist/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/pdfjs-dist/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "NoteForest ${version}"
    },
    "afterPack": "apps/desktop/resources/adhoc-sign.cjs"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE NOTEFOREST_APP_SUPPORT=\"$HOME/Library/Application Support/NoteForest Dev\" NOTEFOREST_LIBRARY=\"$HOME/Documents/NoteForest Dev\" electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE NOTEFOREST_APP_SUPPORT=\"$HOME/Library/Application Support/NoteForest Dev\" NOTEFOREST_LIBRARY=\"$HOME/Documents/NoteForest Dev\" electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@noteforest/core": "0.1.2",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-mathematics": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "katex": "0.18.11",
    "lowlight": "3.3.0",
    "markdown-it": "14.3.3",
    "prosemirror-markdown": "1.13.9",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.17.0",
    "sonner": "2.0.8",
    "zustand": "5.0.16"
  },
  "author": "luk3luca"
}
