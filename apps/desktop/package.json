{
  "name": "@noteforest/desktop",
  "version": "0.0.0-spike.1",
  "private": true,
  "description": "NoteForest Spike 1 desktop shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
