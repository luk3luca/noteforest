      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "The identity "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "a^2 + b^2 = c^2",
                  "anchorIds": [
                    "m3k-a-formula-whole"
                  ]
                }
              },
              {
                "type": "text",
                "text": " contains the term "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "a^2 + b^2 = c^2",
                  "anchorIds": [
                    "m3k-a-formula-term"
                  ]
                }
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "A repeated term "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "x + x + x",
                  "anchorIds": [
                    "m3k-a-formula-ambiguous"
                  ]
                }
              },
              {
                "type": "text",
                "text": " cannot resolve to one occurrence."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
