    "m3k-text": {
      "id": "m3k-text",
      "label": "Text anchor",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "A text anchor binds the word "
              },
              {
                "type": "text",
                "text": "target",
                "marks": [
                  {
                    "type": "anchor",
                    "attrs": {
                      "anchorIds": [
                        "m3k-a-text"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " exactly once, even with surrounding prose."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
    "m3k-formula": {
      "id": "m3k-formula",
