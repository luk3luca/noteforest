  "blocks": {
    "b1": {
      "id": "b1",
      "label": "Eigenvalues",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "An "
              },
              {
                "type": "text",
                "text": "eigenvalue",
                "marks": [
                  {
                    "type": "anchor",
                    "attrs": {
                      "anchorId": "a1"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " is a scalar "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "\\lambda"
                }
              },
              {
                "type": "text",
                "text": " such that "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "Av = \\lambda v"
                }
              },
              {
                "type": "text",
                "text": " for some nonzero vector "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "v"
                }
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
    "b2": {
      "id": "b2",
      "label": "Eigenvector",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "An eigenvector is a nonzero vector "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "v"
                }
              },
              {
                "type": "text",
                "text": " satisfying "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "Av = \\lambda v"
                }
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
    "b3": {
      "id": "b3",
      "label": "Eigenvalue equation",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "The eigenvalue equation is "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "Av = \\lambda v",
                  "anchorId": "a2"
                }
              },
              {
                "type": "text",
                "text": ", with "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "v \\neq 0"
                }
              },
              {
                "type": "text",
                "text": ". It is the bridge between a matrix and its spectrum."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
    "b4": {
      "id": "b4",
      "label": "Cayley–Hamilton",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Every square matrix satisfies its characteristic polynomial: "
              },
              {
                "type": "inlineMath",
                "attrs": {
                  "latex": "p(\\lambda) = \\det(A - \\lambda I)"
                }
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "border": "subtle"
    },
    "b5": {
      "id": "b5",
      "label": "Computing eigenvalues",
      "content": {
        "type": "doc",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "A numerical example uses the "
              },
              {
                "type": "text",
                "text": "eigvals",
                "marks": [
                  {
                    "type": "code"
                  }
                ]
              },
              {
                "type": "text",
                "text": " helper and a short power iteration."
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "text": "import numpy as np\nfrom numpy.linalg import eig\n\ndef spectrum(matrix, tolerance=1e-9):\n    \"\"\"Return a stable eigenvalue estimate.\"\"\"\n    values, vectors = eig(matrix)\n    order = np.argsort(np.abs(values))[::-1]\n    return values[order], vectors[:, order]\n\nA = np.array([[2.0, 1.0], [1.0, 2.0]])\nvals = eigvals(A)\nvecs = vectors(A)\nprint(vals)\nprint(vecs)\n\nfor value in vals:\n    print(f\"lambda = {value:.6f}\")\n\ndef residual(matrix, value, vector):\n    return np.linalg.norm(A @ v - value * v)\n\ndef power_iteration(matrix, steps=100):\n    vector = np.ones(matrix.shape[0])\n    for _ in range(steps):\n        vector = matrix @ vector\n        vector = vector / np.linalg.norm(vector)\n    value = float(vector @ matrix @ vector)\n    return value, vector\n\nvalue, vector = power_iteration(A)\nprint(value)\nprint(vector)\n\nassert residual(A, value, vector) < 1e-6\nassert np.isclose(value, vals[0])\nprint(\"ok\")\n\n# Check the trace identity.\nsame_trace = np.isclose(A.trace(), vals.sum())\nprint(trace_identity)\nprint(\"done\")",
              "language": "python",
              "anchorId": "a3",
              "anchorToken": "eigvals",
              "anchorLine": 11
            }
          }
        ]
      },
      "border": "subtle"
    }
  },
